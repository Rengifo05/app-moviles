# --- Nexo Familia: secretos y archivos generados -----------------------------
# Configuración con valores reales: solo se versiona config/env.example.json.
config/env.*.json
!config/env.example.json
.env
.env.*
!.env.example
# Configuración de Firebase con credenciales del proyecto real.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
ios/firebase_app_id_file.json
lib/firebase_options_*.dart
# Claves de firma.
*.keystore
*.jks
key.properties
*.p8
*.p12
*.mobileprovision
# Localización generada por `flutter pub get`.
lib/l10n/gen/
# Pruebas golden: solo se versionan las imágenes de referencia, no los fallos.
**/failures/
# Backend
functions/node_modules/
functions/lib/
firebase-debug.log
firestore-debug.log
ui-debug.log
.firebase/
# Variantes por entorno o flavor de la configuración de Firebase.
**/google-services.json
**/GoogleService-Info.plist
lib/firebase_options*.dart
# Credenciales del backend (cuentas de servicio, secretos de Functions).
*-firebase-adminsdk-*.json
